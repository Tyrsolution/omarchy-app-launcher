#!/bin/bash

# Remove a custom coding agent from the App Launcher. Only entries you added
# are listed; Omarchy's built-in roster is not editable from here.

set -euo pipefail

CONFIG="$HOME/.config/omarchy/app-launcher/agents.json"

fail() {
  echo "app-launcher-remove-agent: $*" >&2
  exit 1
}

command -v gum >/dev/null || fail "gum is required"
command -v python3 >/dev/null || fail "python3 is required"
[[ -f $CONFIG ]] || fail "no custom agents yet ($CONFIG does not exist)"

mapfile -t names < <(python3 - "$CONFIG" <<'PY'
import json, sys
try:
    with open(sys.argv[1]) as handle:
        config = json.load(handle)
except (OSError, ValueError):
    sys.exit(0)
agents = config.get("agents") if isinstance(config, dict) else None
for agent in agents or []:
    if isinstance(agent, dict) and agent.get("id"):
        print("%s\t%s" % (agent["id"], agent.get("name") or agent["id"]))
PY
)

(( ${#names[@]} )) || fail "no custom agents to remove"

echo
gum style --bold "Remove a custom coding agent"
echo

labels=()
for row in "${names[@]}"; do labels+=("${row#*$'\t'}"); done
choice=$(printf '%s\n' "${labels[@]}" | gum choose --header="Which agent?") || fail "cancelled"

target_id=""
for row in "${names[@]}"; do
  [[ ${row#*$'\t'} == "$choice" ]] && target_id="${row%%$'\t'*}"
done
[[ -n $target_id ]] || fail "could not resolve '$choice'"

gum confirm "Remove $choice from the launcher?" || fail "aborted"

REMOVE_ID="$target_id" python3 - "$CONFIG" <<'PY'
import json, os, sys

path = sys.argv[1]
with open(path) as handle:
    config = json.load(handle)

agents = config.get("agents") or []
config["agents"] = [a for a in agents
                    if not (isinstance(a, dict) and a.get("id") == os.environ["REMOVE_ID"])]
config["version"] = 1
with open(path, "w") as handle:
    json.dump(config, handle, indent=2)
    handle.write("\n")
PY

# Its usage score is dead weight once the tile is gone. The launcher prunes
# entries for things that no longer exist when it closes, so this is only for
# the case where it is open right now.
usage="$HOME/.local/state/omarchy/app-launcher/usage.json"
if [[ -f $usage ]]; then
  REMOVE_KEY="agent:$target_id" python3 - "$usage" <<'PY' || true
import json, os, sys
path = sys.argv[1]
try:
    with open(path) as handle:
        data = json.load(handle)
except (OSError, ValueError):
    sys.exit(0)
entries = data.get("entries")
if isinstance(entries, dict) and entries.pop(os.environ["REMOVE_KEY"], None) is not None:
    with open(path, "w") as handle:
        json.dump(data, handle, indent=2)
        handle.write("\n")
PY
fi

echo
gum style --foreground 2 "✓ $choice removed."
